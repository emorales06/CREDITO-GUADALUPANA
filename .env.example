# Copie a .env (opcional). Todos tienen valores por defecto razonables.
PORT=3000
DB_PATH=data/creditos.db
SESSION_SECRET=cambie-este-secreto
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
SEED_DEMO_DATA=true

# Cliente del buró (resiliencia)
BUREAU_MAX_ATTEMPTS=4
BUREAU_BASE_DELAY_MS=1000
BUREAU_MAX_DELAY_MS=8000
BUREAU_TIMEOUT_MS=6000

# Simulador del buró externo
MOCK_BUREAU_MIN_LATENCY_MS=2000
MOCK_BUREAU_MAX_LATENCY_MS=4000
MOCK_BUREAU_FAILURE_RATE=0.3
